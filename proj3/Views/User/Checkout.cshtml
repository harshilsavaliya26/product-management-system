@model List<poj3.Models.CartItem>
@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "Checkout";
}
<div class="container py-7">
    <h1 class="font-size-30 font-weight-bold mb-5">Checkout</h1>
    @if (TempData["CheckoutError"] != null) { <div class="alert alert-danger">@TempData["CheckoutError"]</div> }
    <div class="row">
        <div class="col-lg-7"><div class="border rounded-lg p-4 bg-white"><h4 class="mb-4">Delivery Details</h4>
            <form asp-action="PlaceOrder" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group"><label>Full Name</label><input name="customerName" class="form-control" required /></div>
                <div class="form-group"><label>Email</label><input name="email" type="email" class="form-control" required /></div>
                <div class="form-group"><label>Phone</label><input name="phone" class="form-control" required /></div>
                <div class="form-group"><label>Delivery Address</label><textarea name="address" class="form-control" rows="4" required></textarea></div>
                <button type="submit" class="btn btn-primary btn-block py-3">Place Order & Buy</button>
            </form>
        </div></div>
        <div class="col-lg-5"><div class="border rounded-lg p-4 bg-white"><h4>Order Summary</h4>@foreach(var item in Model){<div class="d-flex justify-content-between border-bottom py-2"><span>@item.Name × @item.Quantity</span><strong>$@item.Total.ToString("N2")</strong></div>}<div class="d-flex justify-content-between font-size-20 font-weight-bold mt-3"><span>Total</span><span>$@Model.Sum(x=>x.Total).ToString("N2")</span></div></div></div>
    </div>
</div>
