@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "Order Confirmed";
}
<div class="container py-8 text-center">
    <div class="border rounded-lg bg-white p-6">
        <div class="font-size-50 text-green mb-3">✓</div>
        <h1 class="font-size-30 font-weight-bold">Order Placed Successfully!</h1>
        <p class="mt-3">Thank you for your purchase.</p>
        <p><strong>Order Number:</strong> @ViewBag.OrderNumber</p>
        <p><strong>Order Total:</strong> $@ViewBag.Total</p>
        <a asp-action="home" class="btn btn-primary mt-3">Continue Shopping</a>
    </div>
</div>
