@model List<poj3.Models.Product>
@{
    Layout = "~/Views/Shared/_layouthome.cshtml";
    ViewData["Title"] = "Favorites";
}

<div class="container py-7">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="font-size-30 font-weight-bold mb-0">My Favorites</h1>
        <a asp-action="home" class="btn btn-outline-primary">Continue Shopping</a>
    </div>

    @if (TempData["FavoriteMessage"] != null)
    {
        <div class="alert alert-success">@TempData["FavoriteMessage"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center py-8 border rounded-lg bg-white">
            <i class="ec ec-favorites font-size-60 text-muted"></i>
            <h3 class="mt-3">No favorite products yet.</h3>
            <p class="text-muted">Open a product and click the heart button to add it here.</p>
            <a asp-action="home" class="btn btn-primary mt-2">Browse Products</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card h-100 border rounded-lg">
                        <a asp-action="Product" asp-route-id="@product.Id" class="p-3 d-block text-center">
                            <img src="@Url.Content(product.Image)" class="img-fluid" style="height:200px;object-fit:contain" alt="@product.Name" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <div class="small text-muted">@product.Category</div>
                            <a asp-action="Product" asp-route-id="@product.Id" class="font-weight-bold text-dark mt-1">
                                @product.Name
                            </a>
                            <div class="font-size-20 font-weight-bold text-primary mt-3">$@product.Price.ToString("N2")</div>

                            <div class="mt-auto pt-3 d-flex">
                                <a asp-action="Product" asp-route-id="@product.Id" class="btn btn-primary flex-grow-1 mr-2">
                                    View
                                </a>
                                <form asp-action="RemoveFavorite" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@product.Id" />
                                    <button type="submit" class="btn btn-outline-danger" title="Remove from favorites">
                                        <i class="ec ec-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
